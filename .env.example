# Copiar a .env y cambiar los valores. No subir .env al repositorio.

# PostgreSQL
POSTGRES_DB=censo
POSTGRES_USER=censo
POSTGRES_PASSWORD=cambiar-esta-contrasena

# API (en Docker el host es "db" en vez de localhost)
DATABASE_URL=postgres://censo:cambiar-esta-contrasena@localhost:5432/censo
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio
JWT_EXPIRA=8h

# Administrador inicial (solo si no hay usuarios)
ADMIN_CORREO=admin@ejemplo.gt
ADMIN_CONTRASENA=cambiar-esta-contrasena-de-admin

# Carga inicial de los XLSX cuando la base está vacía
IMPORTAR_DATOS_INICIALES=true
CARPETA_DATOS_INICIALES=../datos/crudos

# Puertos locales
PUERTO_WEB=8080
PUERTO_DB=5432
